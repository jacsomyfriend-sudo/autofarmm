-- ================== NOAH'S RANKED DUELS AUTOFARM v7 ==================
repeat task.wait() until game:IsLoaded()

if game.Players.LocalPlayer.Name ~= "NoahSt3alth16" then
    return print("❌ This script can only be executed on NoahSt3alth16")
end

_G.toggle = true
_G.acc1 = "NoahSt3alth16"
_G.acc2 = "irundhcom"

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local LOBBY_ID = 15424972165
local MATCH_ID = 15486406772
local TARGET_POSITION = Vector3.new(48, 18, -59)   -- Your new position

print("✅ Noah's Ranked Autofarm v7 Loaded (New Position)")

local function isAcc2InLobby()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == _G.acc2 then
            return true
        end
    end
    return false
end

local function teleportToPosition()
    if game.PlaceId ~= LOBBY_ID then return end
    if not isAcc2InLobby() then 
        print("Waiting for irundhcom to join lobby...")
        return 
    end

    local character = localPlayer.Character
    if not character then
        character = localPlayer.CharacterAdded:Wait()
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(TARGET_POSITION)
        print("✅ Both accounts in lobby → Teleported to " .. tostring(TARGET_POSITION))
    else
        print("❌ HumanoidRootPart not found")
    end
end

local function joinRanked()
    local args = {"ranked"}
    game:GetService("ReplicatedStorage"):WaitForChild("RequestToJoin"):InvokeServer(unpack(args))
    print(localPlayer.Name .. " → Sent Ranked Request")
end

-- Main Loop
task.spawn(function()
    while _G.toggle do
        task.wait(0.5)

        if game.PlaceId == LOBBY_ID then
            teleportToPosition()

        elseif game.PlaceId == MATCH_ID then
            if localPlayer.Name == "NoahSt3alth16" then
                task.wait(0.5)
                joinRanked()

            elseif localPlayer.Name == "irundhcom" then
                print("irundhcom waiting 7 seconds...")
                task.wait(7)
                joinRanked()
            end
        end
    end
end)

-- Character Added Handler
localPlayer.CharacterAdded:Connect(function()
    task.wait(1.2)
    if game.PlaceId == LOBBY_ID then
        teleportToPosition()
    elseif game.PlaceId == MATCH_ID then
        if localPlayer.Name == "NoahSt3alth16" then
            task.wait(0.5)
            joinRanked()
        elseif localPlayer.Name == "irundhcom" then
            task.wait(7)
            joinRanked()
        end
    end
end)

print("🚀 v7 Running - Using new position (48, 18, -59)")

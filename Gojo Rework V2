-- ================== NOAH'S RANKED DUELS AUTOFARM v2 ==================
repeat task.wait() until game:IsLoaded()

if game.Players.LocalPlayer.Name ~= "NoahSt3alth16" then
    return print("❌ This script can only be executed on NoahSt3alth16")
end

_G.toggle = true
_G.acc1 = "NoahSt3alth16"
_G.acc2 = "irundhcom"

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local LOBBY_ID = 15424972165
local MATCH_ID = 15486406772
local FARM_CFRAME = CFrame.new(35, 18, -66)

print("✅ Noah's Ranked Autofarm Loaded (irundhcom delayed 13.87s)")

local function goToPosition()
    if game.PlaceId ~= LOBBY_ID then return end
    local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 6)
    if hrp then
        hrp.CFrame = FARM_CFRAME
        print(localPlayer.Name .. " → Moved to farm position")
    end
end

local function joinRanked()
    local args = {"ranked"}
    game:GetService("ReplicatedStorage"):WaitForChild("RequestToJoin"):InvokeServer(unpack(args))
    print(localPlayer.Name .. " → Sent Ranked Request")
end

-- Main Loop
task.spawn(function()
    while _G.toggle do
        task.wait(0.7)

        if game.PlaceId == LOBBY_ID then
            -- In Lobby: Keep both accounts at farm position
            goToPosition()

        elseif game.PlaceId == MATCH_ID then
            -- In Ranked Match:
            if localPlayer.Name == "NoahSt3alth16" then
                -- Noah joins fast
                local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
                task.wait(0.6)
                joinRanked()

            elseif localPlayer.Name == "irundhcom" then
                -- irundhcom waits 13.87 seconds
                print("irundhcom waiting 13.87 seconds before joining...")
                task.wait(13.87)
                joinRanked()
            end
        end
    end
end)

-- Safety for character respawn
localPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if game.PlaceId == LOBBY_ID then
        goToPosition()
    elseif game.PlaceId == MATCH_ID then
        if localPlayer.Name == "NoahSt3alth16" then
            task.wait(0.6)
            joinRanked()
        elseif localPlayer.Name == "irundhcom" then
            task.wait(13.87)
            joinRanked()
        end
    end
end)

print("🚀 Script Running - irundhcom delayed by 13.87s in match")

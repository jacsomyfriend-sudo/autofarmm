-- ================== NOAH'S FIXED DUELS AUTOFARM ==================
repeat task.wait() until game:IsLoaded()

if game.Players.LocalPlayer.Name ~= "NoahSt3alth16" then
    return print("❌ This script can only be run on NoahSt3alth16")
end

_G.toggle = true
_G.acc1 = "NoahSt3alth16"
_G.acc2 = "irundhcom"

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local LOBBY_PLACEID = 15424972165
local MATCH_PLACEID = 15486406772
local FARM_POSITION = CFrame.new(35, 18, -66)

print("✅ Noah's Fixed Duels Autofarm Loaded")

-- Teleport to farm position in lobby
local function goToFarmPosition()
    if game.PlaceId ~= LOBBY_PLACEID then return end
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if hrp then
        hrp.CFrame = FARM_POSITION
    end
end

-- Join Ranked
local function joinRanked()
    local args = {"ranked"}
    game:GetService("ReplicatedStorage"):WaitForChild("RequestToJoin"):InvokeServer(unpack(args))
    print(localPlayer.Name .. " joined Ranked")
end

-- ===================== MAIN LOGIC =====================
task.spawn(function()
    while _G.toggle do
        task.wait(0.7)

        if game.PlaceId == LOBBY_PLACEID then
            -- Only teleport to position in lobby, do NOT join here
            goToFarmPosition()

        elseif game.PlaceId == MATCH_PLACEID then
            -- ==================== IN MATCH ====================
            if localPlayer.Name == "NoahSt3alth16" then
                -- Noah joins instantly when character loads
                local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
                if character then
                    task.wait(0.5)  -- small delay after character loads
                    joinRanked()
                end
            elseif localPlayer.Name == "irundhcom" then
                -- irundhcom joins after 3 seconds
                task.wait(3)
                joinRanked()
            end
        end
    end
end)

-- Extra safety: Re-join if character respawns in match
localPlayer.CharacterAdded:Connect(function()
    if game.PlaceId == MATCH_PLACEID then
        task.wait(1)
        if localPlayer.Name == "NoahSt3alth16" then
            joinRanked()
        elseif localPlayer.Name == "irundhcom" then
            task.wait(3)
            joinRanked()
        end
    end
end)

print("🚀 Script Ready - Noah only joins in the match place")

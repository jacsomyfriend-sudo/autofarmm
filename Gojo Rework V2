-- ================== NOAH'S RANKED DUELS AUTOFARM v6 ==================
repeat task.wait() until game:IsLoaded()

if game.Players.LocalPlayer.Name ~= "NoahSt3alth16" then
    return print("❌ This script can only be executed on NoahSt3alth16")
end

_G.toggle = true
_G.acc1 = "NoahSt3alth16"
_G.acc2 = "irundhcom"

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local LOBBY_ID = 15424972165
local MATCH_ID = 15486406772
local FARM_CFRAME = CFrame.new(35, 18, -66)

print("✅ Noah's Ranked Autofarm v6 Loaded")

local function isAcc2InLobby()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == _G.acc2 then
            return true
        end
    end
    return false
end

local function forceTeleport()
    if game.PlaceId ~= LOBBY_ID then return end
    if not isAcc2InLobby() then return end

    local char = localPlayer.Character
    if not char then 
        char = localPlayer.CharacterAdded:Wait()
    end
    
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if hrp then
        hrp.CFrame = FARM_CFRAME
        print("✅ SUCCESS: Both in lobby - Forced teleport to 35, 18, -66")
    end
end

local function joinRanked()
    local args = {"ranked"}
    game:GetService("ReplicatedStorage"):WaitForChild("RequestToJoin"):InvokeServer(unpack(args))
    print(localPlayer.Name .. " → Sent Ranked Request")
end

-- Main Loop
task.spawn(function()
    while _G.toggle do
        task.wait(0.5)

        if game.PlaceId == LOBBY_ID then
            forceTeleport()   -- Much more aggressive

        elseif game.PlaceId == MATCH_ID then
            if localPlayer.Name == "NoahSt3alth16" then
                task.wait(0.5)
                joinRanked()

            elseif localPlayer.Name == "irundhcom" then
                print("irundhcom waiting 7 seconds...")
                task.wait(7)          -- Lowered even more
                joinRanked()
            end
        end
    end
end)

-- Extra aggressive teleport on character added
localPlayer.CharacterAdded:Connect(function()
    task.wait(1.2)
    if game.PlaceId == LOBBY_ID then
        forceTeleport()
    elseif game.PlaceId == MATCH_ID then
        if localPlayer.Name == "NoahSt3alth16" then
            task.wait(0.5)
            joinRanked()
        elseif localPlayer.Name == "irundhcom" then
            task.wait(7)
            joinRanked()
        end
    end
end)

print("🚀 v6 Running - Faster teleport + Lower delay")

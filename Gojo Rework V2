-- ================== NOAH'S RANKED DUELS AUTOFARM ==================
repeat task.wait() until game:IsLoaded()

if game.Players.LocalPlayer.Name ~= "NoahSt3alth16" then
    return print("❌ This script can only be executed on NoahSt3alth16")
end

_G.toggle = true
_G.acc1 = "NoahSt3alth16"
_G.acc2 = "irundhcom"

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local LOBBY_ID = 15424972165
local MATCH_ID = 15486406772
local FARM_CFRAME = CFrame.new(35, 18, -66)

print("✅ Noah's Ranked Autofarm Loaded")

local function goToPosition()
    if game.PlaceId ~= LOBBY_ID then return end
    local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 6)
    if hrp then
        hrp.CFrame = FARM_CFRAME
    end
end

local function joinRanked()
    local args = {"ranked"}
    game:GetService("ReplicatedStorage"):WaitForChild("RequestToJoin"):InvokeServer(unpack(args))
    print(localPlayer.Name .. " → Sent Ranked Request")
end

-- Main Loop
task.spawn(function()
    while _G.toggle do
        task.wait(0.8)

        if game.PlaceId == LOBBY_ID then
            -- In Lobby: Only stay at position, do NOT join
            goToPosition()

        elseif game.PlaceId == MATCH_ID then
            -- In Ranked Match:
            if localPlayer.Name == "NoahSt3alth16" then
                -- Noah joins instantly when loaded into the match
                local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
                task.wait(0.6)   -- Small delay after loading
                joinRanked()

            elseif localPlayer.Name == "irundhcom" then
                -- Alt joins after 3 seconds
                task.wait(3)
                joinRanked()
            end
        end
    end
end)

-- Safety reconnect if character respawns in match
localPlayer.CharacterAdded:Connect(function()
    if game.PlaceId == MATCH_ID then
        task.wait(1)
        if localPlayer.Name == "NoahSt3alth16" then
            joinRanked()
        elseif localPlayer.Name == "irundhcom" then
            task.wait(3)
            joinRanked()
        end
    end
end)

print("🚀 Ready - Noah will only join once inside the match (15486406772)")

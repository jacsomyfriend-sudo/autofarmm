    print("Waiting for irundhcom to join lobby...")
    
    -- Strong wait until irundhcom is in the server
    while _G.toggle and game.PlaceId == LOBBY_ID and not isAcc2InLobby() do
        task.wait(0.5)
    end
    
    if game.PlaceId ~= LOBBY_ID then return end
    
    -- Now both are in lobby, teleport
    local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()

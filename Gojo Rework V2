-- ================== NOAH'S RANKED DUELS AUTOFARM v5 ==================
repeat task.wait() until game:IsLoaded()

if game.Players.LocalPlayer.Name ~= "NoahSt3alth16" then
    return print("❌ This script can only be executed on NoahSt3alth16")
end

_G.toggle = true
_G.acc1 = "NoahSt3alth16"
_G.acc2 = "irundhcom"

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local LOBBY_ID = 15424972165
local MATCH_ID = 15486406772
local FARM_CFRAME = CFrame.new(35, 18, -66)

print("✅ Noah's Ranked Autofarm v5 Loaded (Improved Teleport)")

local function isAcc2InLobby()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == _G.acc2 then
            return true
        end
    end
    return false
end

local function goToPosition()
    if game.PlaceId ~= LOBBY_ID then return end

    -- Wait until irundhcom is detected
    if not isAcc2InLobby() then
        print("Waiting for irundhcom to appear in lobby...")
        repeat
            task.wait(0.4)
        until isAcc2InLobby() or game.PlaceId ~= LOBBY_ID
    end

    if game.PlaceId ~= LOBBY_ID then return end

    -- Teleport Noah
    local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if hrp then
        hrp.CFrame = FARM_CFRAME
        print("✅ Both in lobby - Teleported to 35, 18, -66")
    end
end

local function joinRanked()
    local args = {"ranked"}
    game:GetService("ReplicatedStorage"):WaitForChild("RequestToJoin"):InvokeServer(unpack(args))
    print(localPlayer.Name .. " → Sent Ranked Request")
end

-- Main Loop
task.spawn(function()
    while _G.toggle do
        task.wait(0.5)

        if game.PlaceId == LOBBY_ID then
            goToPosition()

        elseif game.PlaceId == MATCH_ID then
            if localPlayer.Name == "NoahSt3alth16" then
                local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
                task.wait(0.6)
                joinRanked()

            elseif localPlayer.Name == "irundhcom" then
                print("irundhcom waiting 13.24 seconds...")
                task.wait(13.09)
                joinRanked()
            end
        end
    end
end)

-- Character Respawn / Rejoin Handling

local function isAcc2InLobby()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == _G.acc2 then
            return true
        end
    end
    return false
end

local function goToPosition()
    if game.PlaceId ~= LOBBY_ID then return end
    
    -- Only move if BOTH accounts are in the lobby
    if isAcc2InLobby() then
        local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart", 6)
        if hrp then
            hrp.CFrame = FARM_CFRAME
            print("Both accounts in lobby → Teleported to farm position")
        end
    else
        print("Waiting for irundhcom to return to lobby...")
    end
end

local function joinRanked()
    local args = {"ranked"}
    game:GetService("ReplicatedStorage"):WaitForChild("RequestToJoin"):InvokeServer(unpack(args))
    print(localPlayer.Name .. " → Sent Ranked Request")
end

-- Main Loop
task.spawn(function()
    while _G.toggle do

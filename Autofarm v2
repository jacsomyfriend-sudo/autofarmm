local function updateRank()
    local success, result = pcall(function()
        local rankValue = game:GetService("Players").LocalPlayer.leaderstats["Solo Rank"].Value
        rankText.Text = "Rank: 👑" .. tostring(rankValue)
    end)
    
    if not success then
        rankText.Text = "Rank: N/A"
    end
end

